# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local al repo.

# ---- Proveedor de comercio ----
# mock: datos de ejemplo en memoria (para desarrollar sin tienda Shopify)
# shopify: usa la Storefront API de tu tienda
COMMERCE_PROVIDER=mock

# ---- Shopify (solo si COMMERCE_PROVIDER=shopify) ----
# Dominio myshopify de la tienda, sin https://
SHOPIFY_STORE_DOMAIN=latitudcero.myshopify.com
# Versión de la API (trimestral). Revisá la vigente en shopify.dev
SHOPIFY_API_VERSION=2025-07
# Token público de la Storefront API (canal Headless). Solo lectura de catálogo y carrito.
SHOPIFY_STOREFRONT_TOKEN=
# Token privado de la Admin API (app propia). SOLO servidor: escribe metafields de la etiqueta.
SHOPIFY_ADMIN_TOKEN=

# ---- Sesión ----
# Cadena aleatoria larga para firmar la cookie de sesión (openssl rand -hex 32)
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
